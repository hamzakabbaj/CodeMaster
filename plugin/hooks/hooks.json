{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-no-verify.sh\"",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "Checking commit-bypass guard"
          }
        ]
      }
    ]
  }
}
