{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step 5 \u2014 Persona",
  "description": "Create fictional but data-driven representations of target user archetypes. Each persona captures demographics, goals, frustrations, behaviors, and a brief narrative.",
  "type": "object",
  "required": [
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "personas"
      ],
      "properties": {
        "personas": {
          "type": "array",
          "description": "1-3 detailed persona profiles.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "archetype",
              "demographics",
              "bio",
              "goals",
              "frustrations",
              "behaviors",
              "key_patterns",
              "quote"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Persona's fictional name."
              },
              "archetype": {
                "type": "string",
                "description": "Short archetype label (e.g., 'The Solo Technical Creator')."
              },
              "demographics": {
                "type": "object",
                "properties": {
                  "age": {
                    "type": "integer"
                  },
                  "role": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  }
                },
                "description": "Basic demographic information."
              },
              "bio": {
                "type": "string",
                "description": "A narrative paragraph summarizing who this person is and their relationship to the problem."
              },
              "goals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "What the persona wants to achieve."
              },
              "frustrations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "What blocks or frustrates the persona."
              },
              "behaviors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Observable habits and day-to-day actions."
              },
              "key_patterns": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Deeper behavioral patterns and mental models that shape how this persona approaches work."
              },
              "quote": {
                "type": "string",
                "description": "A representative quote that captures the persona's mindset."
              }
            }
          }
        }
      }
    }
  }
}
