# CodeMaster — Plane tracker credentials. Copy to .codemaster/plane.env and fill in.
#   cp <this> .codemaster/plane.env && chmod 600 .codemaster/plane.env
# This file is gitignored — never commit it.
#
# Cloud:        PLANE_API_URL="https://api.plane.so"
# Self-hosted:  PLANE_API_URL="https://plane.your-domain.com"   (instance root, NOT incl. workspace slug)
PLANE_API_URL="https://api.plane.so"

# Personal access token: Plane → Profile Settings → Personal Access Tokens.
PLANE_API_KEY="plane_api_xxxxxxxxxxxxxxxxxxxx"  # pragma: allowlist secret

# Workspace slug (the path segment after the domain in the Plane web URL).
PLANE_WORKSPACE_SLUG=""
