# Plane API credentials — copy this file to ~/.claude/plane.env and fill in.
#   cp plane.env.template ~/.claude/plane.env && chmod 600 ~/.claude/plane.env
#
# Cloud:        PLANE_API_URL="https://api.plane.so"
# Self-hosted:  PLANE_API_URL="https://plane.your-domain.com"  (your instance root)
PLANE_API_URL="https://api.plane.so"

# Personal access token from Plane: Profile Settings -> Personal Access Tokens.
PLANE_API_KEY="plane_api_xxxxxxxxxxxxxxxxxxxx"  # pragma: allowlist secret

# Optional default workspace slug (the part after the domain in the web app URL).
PLANE_WORKSPACE_SLUG=""

# Session cookie for internal API (Pages, etc.) — not covered by the public API.
# Get it from browser DevTools: Application/Storage -> Cookies -> "session-id" value.
# Expires periodically — refresh when calls return 401.
PLANE_SESSION_COOKIE=""
