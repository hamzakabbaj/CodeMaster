#!/bin/sh
# Conventional Commits gate — deterministic enforcement (see docs/01).
# Rejects commit messages that don't match: <type>(<scope>)!: <subject>
# Stored in versioned .githooks/ and activated via: git config core.hooksPath .githooks

msg_file="$1"
# First non-empty, non-comment line is the subject.
subject=$(grep -vE '^\s*#' "$msg_file" | grep -vE '^\s*$' | head -n1)

# Strip a trailing GitHub PR reference like " (#123)" — squash-merges append it
# automatically (CM-37). It is metadata, so it must not count toward the limit.
subject=$(printf '%s' "$subject" | sed -E 's/ \(#[0-9]+\)$//')

# Allow merge/revert/fixup commits to pass through untouched.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

types='feat|fix|chore|docs|refactor|test|perf|build|ci|revert'
pattern="^(${types})(\([a-z0-9._-]+\))?!?: .{1,72}$"

if printf '%s' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<EOF
✗ Commit message rejected by .githooks/commit-msg

  Got:    $subject

  Expected Conventional Commits format:
    <type>(<optional-scope>): <subject ≤72 chars>

  Allowed types: feat fix chore docs refactor test perf build ci revert
  Example:       feat(hooks): add PreToolUse deny-gate

  See CONTRIBUTING.md.
EOF
exit 1
